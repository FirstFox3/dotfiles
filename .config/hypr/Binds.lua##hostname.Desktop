--- Opening Apps
hl.bind("SUPER + Q",             hl.dsp.exec_cmd("kitty"))
hl.bind("SUPER + F",             hl.dsp.exec_cmd("firefox"))
hl.bind("SUPER + E",             hl.dsp.exec_cmd(file_manager))
hl.bind("SUPER + R",             hl.dsp.exec_cmd("wofi"))

--- Mouse controls
hl.bind("SUPER + mouse:272",     hl.dsp.window.drag(),   { mouse = true })
hl.bind("SUPER + mouse:273",     hl.dsp.window.resize(), { mouse = true })

--- Misc                         
hl.bind("SUPER + C",             hl.dsp.window.close())
hl.bind("SUPER + M",             hl.dsp.exec_cmd("uwsm stop"))
hl.bind("SUPER + V",             hl.dsp.window.float())
hl.bind("F11",                   hl.dsp.window.fullscreen())
hl.bind("SUPER + T",             hl.dsp.focus({ workspace = "emptynm" }))
hl.bind("SUPER + SHIFT + T",     hl.dsp.window.move({ workspace = "emptynm" }))
--  Volume
hl.bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, ignore_mods = true, repeating = true })
hl.bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-"), { locked = true, ignore_mods = true, repeating = true })
hl.bind("XF86AudioMute",         hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle")    , { locked = true, ignore_mods = true })
--  Audio
hl.bind("XF86AudioPause",        hl.dsp.exec_cmd("playerctl play-pause"), { locked = true, ignore_mods = true })
hl.bind("XF86AudioPlay",         hl.dsp.exec_cmd("playerctl play-pause"), { locked = true, ignore_mods = true })
hl.bind("XF86AudioNext",         hl.dsp.exec_cmd("playerctl next"),       { locked = true, ignore_mods = true })
hl.bind("XF86AudioPrev",         hl.dsp.exec_cmd("playerctl previous"),   { locked = true, ignore_mods = true })

--- Arrow Keys                   
--  Move Focus                   
hl.bind("SUPER + left",          hl.dsp.focus({ direction = "l" }))
hl.bind("SUPER + right",         hl.dsp.focus({ direction = "r" }))
hl.bind("SUPER + up",            hl.dsp.focus({ direction = "u" }))
hl.bind("SUPER + down",          hl.dsp.focus({ direction = "d" }))

--  Move Focused Window
hl.bind("SUPER + SHIFT + left",  hl.dsp.window.move({ direction = "l" }))
hl.bind("SUPER + SHIFT + right", hl.dsp.window.move({ direction = "r" }))
hl.bind("SUPER + SHIFT + up",    hl.dsp.window.move({ direction = "u" }))
hl.bind("SUPER + SHIFT + down",  hl.dsp.window.move({ direction = "d" }))

--- NeoVim Movement
--  Move Focus
hl.bind("SUPER + h",             hl.dsp.focus({ direction = "l" }))
hl.bind("SUPER + l",             hl.dsp.focus({ direction = "r" }))
hl.bind("SUPER + k",             hl.dsp.focus({ direction = "u" }))
hl.bind("SUPER + j",             hl.dsp.focus({ direction = "d" }))
--  Move Focused Window
hl.bind("SUPER + SHIFT + h",     hl.dsp.window.move({ direction = "l" }))
hl.bind("SUPER + SHIFT + l",     hl.dsp.window.move({ direction = "r" }))
hl.bind("SUPER + SHIFT + k",     hl.dsp.window.move({ direction = "u" }))
hl.bind("SUPER + SHIFT + j",     hl.dsp.window.move({ direction = "d" }))

--- Workspaces (Change later for personalized setup)
hl.bind("SUPER + SHIFT + TAB", hl.dsp.focus({ workspace = "m-1" }))
hl.bind("SUPER + TAB",         hl.dsp.focus({ workspace = "m+1" }))
