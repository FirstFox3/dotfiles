import Quickshell
import QtQuick
import QtQml.Models

Variants {
	model: Quickshell.screens

	PanelWindow {
		property var modelData

		screen: modelData

		id: root

		color: Colors.background
		
		anchors {
			top: true
			left: true
			right: true
		}

		implicitHeight: 40

		Time {
			id: time

			anchors.centerIn: parent
		}

		{% if yadm.hostname == "Laptop" %}
		Battery {
			id: battery

			anchors.verticalCenter: parent.verticalCenter
		}

		{% endif %}
	}
}
